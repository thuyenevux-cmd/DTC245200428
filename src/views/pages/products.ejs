<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <h2>Danh mục sản phẩm</h2>
    <p class="page-head__desc">Mã hàng, giá vốn, giá bán và ngưỡng nhập lại của từng mã hàng trong kho.</p>
  </div>
  <div class="page-head__actions">
    <a class="btn btn--primary" href="/products/new">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
      Thêm sản phẩm
    </a>
  </div>
</div>

<form class="filters" method="get" action="/products">
  <div class="search">
    <span class="search__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    </span>
    <input class="input" type="search" name="q" value="<%= filters.q %>" placeholder="Tìm theo tên hoặc mã hàng" aria-label="Tìm sản phẩm" />
  </div>
  <select class="select" name="category" aria-label="Lọc theo nhóm hàng">
    <option value="">Tất cả nhóm hàng</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= String(filters.categoryId) === String(c.id) ? 'selected' : '' %>><%= c.name %> (<%= c.product_count %>)</option>
    <% }); %>
  </select>
  <select class="select" name="sort" aria-label="Sắp xếp">
    <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Sắp xếp: tên</option>
    <option value="quantity" <%= filters.sort === 'quantity' ? 'selected' : '' %>>Sắp xếp: tồn thực</option>
    <option value="value" <%= filters.sort === 'value' ? 'selected' : '' %>>Sắp xếp: giá trị tồn</option>
    <option value="price" <%= filters.sort === 'price' ? 'selected' : '' %>>Sắp xếp: giá vốn</option>
  </select>
  <button class="btn btn--secondary" type="submit">Lọc</button>
  <% if (filters.q || filters.categoryId) { %>
    <a class="btn btn--ghost" href="/products">Bỏ lọc</a>
  <% } %>
</form>

<section class="card">
  <% if (!rows.length) { %>
    <div class="empty">
      <div class="empty__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7 12 3l8 4-8 4z" /><path d="M4 7v10l8 4 8-4V7" /></svg>
      </div>
      <p class="empty__title">Không có sản phẩm phù hợp</p>
      <p class="empty__text">Thử bỏ bộ lọc, hoặc thêm mã hàng mới vào danh mục.</p>
      <a class="btn btn--primary" href="/products/new">Thêm sản phẩm</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Mã hàng</th>
            <th>Tên hàng</th>
            <th>Nhóm</th>
            <th class="text-right">Giá vốn</th>
            <th class="text-right">Giá bán</th>
            <th class="text-right">Tồn thực</th>
            <th class="text-right">Ngưỡng</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (p) { const status = format.stockStatus(p); %>
            <tr>
              <td class="table__code"><%= p.sku %></td>
              <td>
                <%= p.name %>
                <div class="table__sub">Đơn vị: <%= p.unit %></div>
              </td>
              <td class="text-muted"><%= p.category_name || 'Chưa phân nhóm' %></td>
              <td class="text-right num"><%= format.currency(p.cost_price) %></td>
              <td class="text-right num"><%= format.currency(p.sale_price) %></td>
              <td class="text-right num">
                <%= format.number(p.quantity) %>
                <span class="chip chip--<%= status.key %>" style="margin-left: 6px"><%= status.label %></span>
              </td>
              <td class="text-right num text-muted"><%= format.number(p.reorder_point) %></td>
              <td>
                <div class="table__actions">
                  <a class="btn btn--ghost btn--icon" href="/products/<%= p.id %>/edit" aria-label="Sửa <%= p.sku %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                  </a>
                  <form method="post" action="/products/<%= p.id %>/delete" data-confirm="Xoá mã hàng <%= p.sku %>? Sổ kho và lịch sử giao dịch của mã hàng này cũng bị xoá.">
                    <button class="btn btn--ghost btn--icon" type="submit" aria-label="Xoá <%= p.sku %>">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', { currentPage: page, totalPages: pages, total: total, query: filters, baseUrl: '/products' }) %>
  <% } %>
</section>

<%- include('../partials/foot') %>
