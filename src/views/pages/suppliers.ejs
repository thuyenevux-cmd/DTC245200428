<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <h2>Nhà cung cấp</h2>
    <p class="page-head__desc">Đơn vị cung cấp hàng cho kho. Nhà cung cấp được chọn khi ghi phiếu nhập.</p>
  </div>
  <div class="page-head__actions">
    <a class="btn btn--primary" href="/suppliers/new">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
      Thêm nhà cung cấp
    </a>
  </div>
</div>

<form class="filters" method="get" action="/suppliers">
  <div class="search">
    <span class="search__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    </span>
    <input class="input" type="search" name="q" value="<%= filters.q %>" placeholder="Tìm theo tên, mã hoặc email" aria-label="Tìm nhà cung cấp" />
  </div>
  <button class="btn btn--secondary" type="submit">Tìm</button>
  <% if (filters.q) { %><a class="btn btn--ghost" href="/suppliers">Bỏ lọc</a><% } %>
</form>

<section class="card">
  <% if (!suppliers.length) { %>
    <div class="empty">
      <div class="empty__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M10 21v-4h4v4" /></svg>
      </div>
      <p class="empty__title">Chưa có nhà cung cấp</p>
      <p class="empty__text">Thêm đơn vị cung cấp để ghi phiếu nhập hàng.</p>
      <a class="btn btn--primary" href="/suppliers/new">Thêm nhà cung cấp</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Mã</th>
            <th>Tên nhà cung cấp</th>
            <th>Liên hệ</th>
            <th>Địa chỉ</th>
            <th class="text-right">Phiếu nhập</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% suppliers.forEach(function (s) { %>
            <tr>
              <td class="table__code"><%= s.code %></td>
              <td><%= s.name %></td>
              <td>
                <%= s.phone || '—' %>
                <% if (s.email) { %><div class="table__sub"><%= s.email %></div><% } %>
              </td>
              <td class="text-muted"><%= s.address || '—' %></td>
              <td class="text-right num"><%= format.number(s.document_count) %></td>
              <td>
                <div class="table__actions">
                  <a class="btn btn--ghost btn--icon" href="/suppliers/<%= s.id %>/edit" aria-label="Sửa <%= s.name %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                  </a>
                  <form method="post" action="/suppliers/<%= s.id %>/delete" data-confirm="Xoá nhà cung cấp <%= s.name %>?">
                    <button class="btn btn--ghost btn--icon" type="submit" aria-label="Xoá <%= s.name %>">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/foot') %>
